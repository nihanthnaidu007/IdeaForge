# --- Dependencies ---
node_modules/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# --- Builds & coverage ---
build/
dist/
coverage/

# --- Environment files: real envs never leave the machine ---
# Templates (*.env.example) stay tracked; everything else env-shaped is ignored.
.env
.env.*
*.env
!*.env.example

# --- Credentials & keys ---
*.pem
*token.json*
*credentials.json*

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Editors & OS ---
.idea/
.vscode/
.DS_Store
