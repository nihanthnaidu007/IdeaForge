{
  "identity": {
    "name": "IdeaForge",
    "mission": "Build a production-grade LinkedIn Idea Generator called IdeaForge",
    "persona": "The Architect of Influence",
    "tone": "Precision, Insight, High-Tech, Premium",
    "aesthetics": "Cyber-SaaS, Dark Mode, Glowing Borders, Data Density"
  },
  "typography": {
    "headings": {
      "font_family": "Syne, sans-serif",
      "weights": ["700", "800"],
      "usage": "Use for all H1-H3. Tight tracking (-0.02em).",
      "fallback": "system-ui"
    },
    "body": {
      "font_family": "DM Mono, monospace",
      "weights": ["400", "500"],
      "usage": "Use for all body text, data, and UI elements.",
      "fallback": "monospace"
    },
    "scale": {
      "h1": "text-5xl md:text-7xl font-bold tracking-tight",
      "h2": "text-3xl md:text-5xl font-bold tracking-tight",
      "h3": "text-xl md:text-2xl font-semibold",
      "body": "text-sm md:text-base leading-relaxed",
      "label": "text-xs uppercase tracking-widest text-muted-foreground"
    }
  },
  "colors": {
    "background": {
      "default": "#050508",
      "paper": "#0A0A0C",
      "elevated": "#121215"
    },
    "primary": {
      "main": "#D4F844",
      "hover": "#B8D935",
      "foreground": "#050508",
      "description": "Electric Lime - Use sparingly for high-value CTAs and active states."
    },
    "secondary": {
      "main": "#27272A",
      "foreground": "#FFFFFF"
    },
    "accent": {
      "cyan": "#00E5FF",
      "purple": "#A855F7"
    },
    "border": {
      "default": "rgba(255,255,255,0.08)",
      "active": "rgba(212, 248, 68, 0.3)"
    },
    "rating": {
      "high": "#22C55E",
      "medium": "#F59E0B",
      "low": "#52525B"
    }
  },
  "visual_enhancers": {
    "borders": "1px solid rgba(255,255,255,0.08)",
    "glassmorphism": "backdrop-blur-xl bg-black/40 border-white/10",
    "shadows": {
      "card": "0 0 0 1px rgba(255,255,255,0.05), 0 4px 20px -2px rgba(0,0,0,0.5)",
      "glow": "0 0 20px rgba(212, 248, 68, 0.15)"
    },
    "gradients": {
      "mesh": "radial-gradient(circle at 50% 0%, rgba(212, 248, 68, 0.05) 0%, transparent 50%)",
      "card_hover": "linear-gradient(180deg, rgba(255,255,255,0.05) 0%, transparent 100%)"
    }
  },
  "components": {
    "IdeaCard": {
      "description": "Expandable card displaying generated ideas with scores.",
      "features": [
        "Accordion-style expansion",
        "Color-coded rating bar (Top right)",
        "Staggered entrance animation",
        "Tracing beam border on hover"
      ],
      "path": "/app/frontend/src/components/ui/IdeaCard.js"
    },
    "TrendScanner": {
      "description": "Visual component showing live scanning of trends.",
      "features": [
        "Animated list items appearing one by one",
        "Scanning radar effect or pulsing dot",
        "Monospace font for 'terminal' feel"
      ],
      "path": "/app/frontend/src/components/ui/TrendScanner.js"
    },
    "FormatSelector": {
      "description": "Pill-shaped selector for post formats (Hot Take, Carousel, etc.).",
      "features": [
        "Horizontal scroll on mobile",
        "Active state: Primary Color background + Black text",
        "Inactive state: Transparent + White text + Border"
      ],
      "path": "/app/frontend/src/components/ui/FormatSelector.js"
    },
    "RatingBadge": {
      "description": "Displays the score (0-10) with appropriate color.",
      "logic": "Score >= 8 ? Green : Score >= 6 ? Amber : Grey",
      "path": "/app/frontend/src/components/ui/RatingBadge.js"
    }
  },
  "layout_strategy": {
    "landing_page": {
      "type": "Bento Grid (Tetris Mode)",
      "structure": [
        "Hero: Col-span-full (Large distinct typography + Abstract BG)",
        "Features: 3-column grid with glass cards",
        "Testimonials: Marquee or Masonry grid"
      ]
    },
    "dashboard": {
      "type": "High Density Grid",
      "structure": [
        "Sidebar: Collapsible icon rail",
        "Main: 2/3 width for Idea Stream",
        "Right Panel: 1/3 width for Saved/Trending (or overlay on mobile)"
      ]
    }
  },
  "motion": {
    "stagger": "staggerChildren: 0.1",
    "card_entrance": "initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.4 }}",
    "hover": "scale: 1.01, borderColor: 'rgba(212, 248, 68, 0.3)'",
    "accordion": "animate-accordion-down / animate-accordion-up"
  },
  "image_urls": {
    "hero_bg": "https://images.unsplash.com/photo-1762278805026-9e0e673e5dc4?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTY2NjZ8MHwxfHNlYXJjaHwyfHxhYnN0cmFjdCUyMGRhcmslMjBuZW9uJTIwbmV0d29yayUyMGNvbm5lY3Rpb258ZW58MHx8fHwxNzcyNzUwOTk2fDA&ixlib=rb-4.1.0&q=85",
    "tech_setup": "https://images.unsplash.com/photo-1645070858656-816d780df8e0?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxODF8MHwxfHNlYXJjaHwzfHx0ZWNoJTIwcHJvZmVzc2lvbmFsJTIwdXNpbmclMjBtdWx0aXBsZSUyMHNjcmVlbnMlMjBkYXJrJTIwbW9kZXxlbnwwfHx8fDE3NzI3NTA5OTd8MA&ixlib=rb-4.1.0&q=85",
    "testimonials": [
      "https://images.unsplash.com/photo-1762522926157-bcc04bf0b10a?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxODh8MHwxfHNlYXJjaHwxfHxtb2Rlcm4lMjBwcm9mZXNzaW9uYWwlMjBoZWFkc2hvdCUyMHBvcnRyYWl0fGVufDB8fHx8MTc3Mjc1MDk5OHww&ixlib=rb-4.1.0&q=85",
      "https://images.unsplash.com/photo-1758613654360-45f1ff78c0cf?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxODh8MHwxfHNlYXJjaHwzfHxtb2Rlcm4lMjBwcm9mZXNzaW9uYWwlMjBoZWFkc2hvdCUyMHBvcnRyYWl0fGVufDB8fHx8MTc3Mjc1MDk5OHww&ixlib=rb-4.1.0&q=85",
      "https://images.pexels.com/photos/30004324/pexels-photo-30004324.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
    ]
  },
  "instructions_to_main_agent": [
    "Install 'framer-motion', 'lucide-react', 'clsx', 'tailwind-merge' immediately.",
    "Set up the Tailwind config to include the 'Syne' and 'DM Mono' fonts.",
    "Import fonts in index.css using @import url('https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Syne:wght@400..800&display=swap');",
    "Create a reusable 'Layout' component that enforces the max-width and padding.",
    "Use the 'stagger' pattern for the Idea Cards list. They must not appear all at once.",
    "The Rating Badge must dynamically change color based on the score prop.",
    "Authentication pages (Login/Signup) should be centered in a glassmorphic card over the animated mesh background."
  ],
  "universal_guidelines": [
    "Do not center text by default. Left align is the standard for tech.",
    "Use sufficient contrast. Dark mode does not mean invisible text.",
    "All interactive elements must have a hover state.",
    "Use data-testid attributes for all inputs and buttons."
  ]
}