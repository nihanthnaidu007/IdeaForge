# IdeaForge frontend configuration.
# Copy to frontend/.env.local and adjust. Never commit your .env.local.

# Base URL of the IdeaForge API (no trailing slash, no /api suffix — the app appends /api).
# Vite exposes only VITE_*-prefixed variables to the app.
VITE_BACKEND_URL=http://127.0.0.1:8001

# Legacy fallback: REACT_APP_BACKEND_URL is still read if VITE_BACKEND_URL is unset
# (kept for pre-migration .env.local files). Prefer VITE_BACKEND_URL.
# REACT_APP_BACKEND_URL=http://127.0.0.1:8001
