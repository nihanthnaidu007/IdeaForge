# IdeaForge backend configuration.
# Copy to backend/.env and fill in real values. Never commit your .env.
#
# The app refuses to boot without MONGO_URL, JWT_SECRET, and a valid
# 32-byte base64 ENCRYPTION_MASTER_KEY.

# --- Environment ---
# dev (default) or prod. In prod, a CORS_ORIGINS "*" wildcard is rejected
# at startup.
ENV=dev

# --- Required ---
# MongoDB connection string (local mongod or a MongoDB Atlas SRV URI)
MONGO_URL=mongodb://127.0.0.1:27017
# Database name
DB_NAME=ideaforge

# --- Secrets (REQUIRED) ---
# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-value
# 32-byte base64 master key for BYOK envelope encryption — generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Used by the AES-256-GCM vault that encrypts every stored user API key.
ENCRYPTION_MASTER_KEY=generate-a-32-byte-base64-value

# --- Token lifetimes ---
# Access tokens are deliberately short (60 minutes) and revocable via
# token_version: any logout or detected refresh-token reuse bumps the user's
# version and immediately invalidates every outstanding access token.
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# --- CORS ---
# Comma-separated list of allowed origins. A "*" wildcard is unsafe with
# credentialed requests and is rejected in production at boot.
CORS_ORIGINS=http://localhost:3000

# --- Auth rate limiting ---
# Login/register/refresh/logout attempts allowed per client per minute (429 +
# Retry-After beyond this). TRUSTED_PROXY: set true only behind a proxy that
# APPENDS the client address to X-Forwarded-For (nginx's proxy_add_x_forwarded_for).
# The limiter then keys on the rightmost (proxy-observed) hop, so a spoofed
# leftmost value cannot rotate the key and bypass the limit.
RATE_LIMIT_AUTH_PER_MINUTE=10
TRUSTED_PROXY=false

# --- Optional server-default provider keys ---
# Users normally bring their own keys (Settings) — those are stored
# envelope-encrypted. These are operator-level fallbacks used when a user
# has not saved a key for that provider.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional model overrides ---
OPENAI_MODEL=gpt-5.2
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Bundled-key daily allowances (hybrid AI-payment model) ---
# Per-user daily caps on server-default key usage. BYOK keys are never capped
# or counted — caps bound the operator's spend, never the user's own keys.
BUNDLED_DAILY_LLM_LIMIT=25
BUNDLED_DAILY_RESEARCH_LIMIT=10

# --- Optional infrastructure ---
# Shared rate-limit state across workers (redis://...)
REDIS_URL=
# Email transport for draft-queue reminders (smtp://user:pass@host:port)
SMTP_URL=
# Log verbosity (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO

# --- Provider base-URL overrides (optional, advanced) ---
# Point provider clients at a self-hosted proxy or a mock server (E2E tests).
# Empty/None = the real public APIs; defaults preserve current behavior exactly.
TAVILY_BASE_URL=
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# --- Draft-queue reminder scan interval ---
# Seconds between draft-queue scans for due reminders (default 60). Lower it in
# tests to make reminder firing deterministic; production keeps the default.
REMINDER_INTERVAL_SECONDS=60
