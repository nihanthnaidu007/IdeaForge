# IdeaForge backend configuration.
# Copy to backend/.env and fill in real values. Never commit your .env.

# --- Required ---
# MongoDB connection string (local mongod or a MongoDB Atlas SRV URI)
MONGO_URL=mongodb://127.0.0.1:27017
# Database name
DB_NAME=ideaforge

# --- Secrets (REQUIRED for any shared or production deployment) ---
# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-value
# 32-byte base64 master key for BYOK envelope encryption — generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Consumed by the encryption PR; until then keys are not yet stored at rest.
ENCRYPTION_MASTER_KEY=generate-a-32-byte-base64-value

# --- CORS ---
# Comma-separated list of allowed origins. A "*" wildcard with credentials is
# unsafe and will be rejected in production (hardening PR enforces this).
CORS_ORIGINS=http://localhost:3000

# --- Optional server-default provider keys ---
# Users normally bring their own keys (Settings). These are operator-level
# fallbacks used when a user has not saved a key for that provider.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional model overrides ---
OPENAI_MODEL=gpt-5.2
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional infrastructure ---
# Shared rate-limit state across workers (redis://...)
REDIS_URL=
# Email transport for draft-queue reminders (smtp://user:pass@host:port)
SMTP_URL=
